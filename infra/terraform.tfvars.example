project_id          = "your-gcp-project-id"
environment         = "staging"
container_image     = "us-docker.pkg.dev/cloudrun/container/hello:latest"
bootstrap_mode      = true
allowed_origins     = "https://your-firebase-project-id.web.app"
frontend_base_url   = "https://your-firebase-project-id.web.app"
deletion_protection = false
# alert_notification_channels = ["projects/your-gcp-project-id/notificationChannels/123"]

# Request pool 10 + infrastructure pool 2 = at most 12 DB connections per instance.
service_min_instances = 1
service_max_instances = 5
revision_max_instances = 5
request_concurrency = 100
