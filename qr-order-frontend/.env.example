# Spring Boot API origin deployed on Cloud Run. No trailing /api path.
# Set this value in the build environment before publishing to Firebase Hosting.
VITE_API_BASE_URL=https://qr-order-api-PROJECT_NUMBER.asia-northeast3.run.app

# Local UI development only. Production builds always require VITE_API_BASE_URL.
# VITE_ENABLE_MOCKS=true

# Local development only: use these in .env.development.local when Cloud Run's
# CORS allowlist does not include localhost. API_PROXY_TARGET is server-only.
# VITE_API_BASE_URL=/__gcp_api__
# API_PROXY_TARGET=https://qr-order-api-PROJECT_NUMBER.asia-northeast3.run.app

# Pause unused customer menu SSE/polling after 5 minutes. Cart/order/staff screens stay active.
VITE_CUSTOMER_IDLE_MS=300000
