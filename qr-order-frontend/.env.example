# Versioned Apps Script Web App deployment URL ending in /exec.
# Netlify must define the same value in Site configuration > Environment variables.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Staff POS deployment — a SEPARATE Apps Script /exec from the customer one.
# The customer bundle must never carry the operational URL
# (docs/qr-order/apps-script-api-design.md §1).
VITE_STAFF_APPS_SCRIPT_URL=https://script.google.com/macros/s/STAFF_DEPLOYMENT_ID/exec
